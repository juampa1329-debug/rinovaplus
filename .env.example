# Copy once to the private .env in this repository root. Never commit credentials.
# Local FastAPI loads that exact file; existing process variables take precedence.
# Use single-quoted values for literal $, ${NAME}, # and spaces in both Python
# and Compose, including double quotes inside the value. Escaped single quotes
# differ between readers: use the process environment for that case; see the guide.
# See docs/configuration.md. Filling keys does not activate connections.

# Safe defaults. SQL catalogs and external AI calls remain disabled.
CRM_APP_MODE=local_demo
CRM_AI_OUTBOUND_ENABLED=false

# Meta subscription GET verification only. SHA-256 hex of a strong random token.
# Keep the token itself outside this file. Empty/invalid digest returns 503.
# This does not enable webhook ingestion, account connections or message sending.
CRM_META_VERIFY_TOKEN_SHA256=

# SQL target contract. Safe default: approved local copy, no new operational mode.
# See docs/adaptation/sql/P1_2_CONTRACT.md before selecting institutional.
CRM_SQL_ENVIRONMENT=local_copy
# Leave host AND port empty for the existing local-instance transport.
# For approved TCP, fill host, port and both restricted credentials together.
CRM_CATALOG_TOKEN=
CRM_SQL_HOST=
CRM_SQL_PORT=
CRM_SQL_USER=
CRM_SQL_PASSWORD=
# Explicit local-copy mode requires the approved local machine and certificate.
# CRM_APP_MODE=local_sql_copy
CRM_SQL_EXPECTED_MACHINE=
CRM_SQL_CERTIFICATE_HOSTNAME=
# Institutional requires explicit DATABASE, TCP HOST/PORT, certificate hostname,
# restricted USER/PASSWORD and every EXPECTED_* identity below (also MACHINE).
# The names are metadata values, independent of a DNS alias or Docker service.
# DEFAULT means SERVERPROPERTY('InstanceName') IS NULL; no wildcard is accepted.
# CRM_SQL_ENVIRONMENT=institutional
# CRM_SQL_DATABASE=CBN_SIIE
# CRM_SQL_EXPECTED_SERVER=CBN-SQL
# CRM_SQL_EXPECTED_INSTANCE=DEFAULT
# CRM_SQL_EXPECTED_LOGIN=cbn_catalog
# CRM_SQL_EXPECTED_DATABASE_USER=cbn_catalog_user
# Keep CRM_APP_MODE=local_demo for offline preparation. Institutional workspace,
# workers and write routes remain blocked; this does not grant DB permissions.
# Public PEM path for the explicit compose.local-sql.yaml overlay, never a key.
CRM_SQL_PUBLIC_CERT_FILE=
# Legacy local-instance guard (not an institutional endpoint):
# CRM_SQL_SERVER=localhost\SQLEXPRESS
# CRM_SQL_DATABASE=DBSIIE
# Local catalog origins default to ports 5173; Compose fixes them to port 4173.
# CRM_CATALOG_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Text providers. Choose the provider/model and enable it separately in Settings.
GEMINI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Voice providers. Voice/model selection is separate from these credentials.
ELEVENLABS_API_KEY=
GOOGLE_TTS_API_KEY=

# Search providers; not required for ordinary text chat.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=

# Optional absolute local AI state directory; empty uses this checkout's .local.
# Compose owns its durable /var/lib/crm-ai volume and ignores this host path.
# Piper has no API key: it uses piper/.venv and piper/voices below this directory.
CRM_AI_STATE_DIR=

# RESERVED ONLY: Meta adapters are NOT implemented. No reader or Compose
# injection consumes these fields. They do not connect accounts or send messages.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
META_VERIFY_TOKEN=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
