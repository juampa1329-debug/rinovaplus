# Shell entrypoints must remain executable by Bash after a Windows checkout.
docker/*.sh text eol=lf

# Migration manifests and their inputs are verified by byte-level SHA-256.
backend/migrations/** -text
backend/operations/** -text
backend/app/institutional/model_settings.py -text
backend/app/institutional/models.py -text
backend/app/institutional/policy.py -text
backend/app/institutional/spanish_bindings.py -text
backend/tools/es_schema_catalog.py -text
backend/tools/es_schema_catalog_v2.py -text
backend/tools/es_schema_migrate.py -text
backend/tools/es_schema_migrate_v2.py -text
backend/tools/institutional_migrations.py -text
backend/tools/p2_es_migrations.py -text
docs/adaptation/sql/p2-channel-fields.json -text
# Live acceptance evidence is hashed in the progress ledger.
artifacts/live/** -text

# Keep delivered provider contracts byte-identical to their recorded hashes.
docs/contracts/siie/20261119*/** -text
docs/contracts/siie/20261127/** -text

# Preserve the existing mixed line endings in the institutional message catalog.
frontend/src/institution/api.tsx -text

# Packaged CRM skills are checked against byte-level manifest hashes.
backend/app/modules/agents/skills/**/SKILL.md text eol=lf
backend/app/modules/agents/skills/manifest.json text eol=lf
