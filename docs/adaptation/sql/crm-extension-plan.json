  "required_contracts": [
    {
      "id": "partition_v2",
      "status": "not_implemented",
      "requirement": "New exact-object metadata/data reader and guard. Keep foundation_snapshot.py and foundation.py unchanged. Unknown schemas/objects, hidden metadata, object-kind substitution and case/accent collisions reject; no blanket crm_* exclusion. Preexisting object universe must match accepted C5 metadata, not blindly adopt a fresh initial catalog. Validate exact new-actor ACL overlay before projecting only its enumerated changes."
    },
    {
      "id": "preservation",
      "status": "not_implemented",
      "requirement": "Capture full academic metadata/ACL/data binary signatures and foundation metadata/data immediately before rehearsal; compare after success, NOOP, failure and reconciliation. Private row/table hashes only; report scalar results."
    },
    {
      "id": "security",
      "status": "not_implemented",
      "requirement": "Separate explicit schema preparation and migration actor; no runtime/admin fallback. DDL allowlist crm_channels only; REFERENCES only exact crm.Contact/Conversation/Message. Preserve C4 runtime ACL and all earlier principals; no academic object/DML/EXECUTE permissions or schema ownership for runtime."
    },
    {
      "id": "history",
      "status": "not_implemented",
      "requirement": "Keep existing journal schema and immutable five-row C3 prefix; validate C3 history then new release chain. Commit STARTED separately before DDL, COMMITTED atomically with B011 DDL, FAILED_ROLLED_BACK after rollback. Any uncertain COMMIT including STARTED quarantines/reconciles; no blind retry. C3 runner/release never reissued or rehashed. Preserve old ShapeVersion/hash semantics; validate new version separately (varchar32). SuccessKey is globally unique by UnitId: never reuse successful B011 with different bytes; changed work needs a new forward unit."
    },
    {
      "id": "destination",
      "status": "not_implemented",
      "requirement": "New restored database identity, new files, no REPLACE; exact TLS/server/database/login/SID ticket. Rehearsal engine16/compat160 explicit; engine15 institutional acceptance separately with compatibility130/140/150 per P1.2, without changing database compatibility. Never point C4 ticket/profile at new destination."
    },
    {
      "id": "snapshots",
      "status": "not_implemented",
      "requirement": "Independent reference + trial restored from same populated C5 backup; freeze canonical before/after shapes and package hashes before trial. Original seven tables unchanged; eight new tables empty; stable named PK/UQ/FK/CHECK/default/index, BIN2 identifiers, triggers and permissions verified."
    },
    {
      "id": "runtime_promotion",
