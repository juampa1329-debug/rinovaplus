    },
    {
      "id": "p3ref_read_handoff_conflicts",
      "label": "read handoff conflicts",
      "rationale": "Preservar CAS/idempotencia/watermark/epoch y revocación del trabajo bot al tomar control. La paridad funcional no autoriza degradar esas guardas a un booleano sin revisión.",
      "file_type": "document",
      "source_file": "artifacts/p3-es/reference-source-review.json",
