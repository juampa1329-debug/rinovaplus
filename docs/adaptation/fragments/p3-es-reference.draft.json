    },
    {
      "id": "p3ref_shared_contact",
      "label": "shared contact",
      "rationale": "Mantener una ficha por identidad compartida; cada dato tiene una sola zona de edición. Datos académicos oficiales conservan autoridad SIIE y no se copian a campos manuales.",
      "file_type": "document",
      "source_file": "artifacts/p3-es/reference-source-review.json",
      "source_location": "$.findings.shared_contact",
      "source_url": null,
