    },
    {
      "id": "p3ref_human_assignment",
      "label": "human assignment",
      "rationale": "No convertir UserId en EmployeeId ni inventar empleados académicos. La asignación operativa necesita contrato propio con AccessUser y permisos actuales; mantener IA separada.",
      "file_type": "document",
      "source_file": "artifacts/p3-es/reference-source-review.json",
      "source_location": "$.findings.human_assignment",
      "source_url": null,
